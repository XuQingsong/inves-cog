# Copy to .env locally. Supply values only in the ignored .env or process environment.
# M1/M2: official Alpaca credentials, with SIP historical market-data permission.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_USER_AGENT=

# R4: approved Alibaba Cloud Token Plan, OpenAI-compatible dialogue transport.
# Hard tasks use glm-5.3; standard tasks use deepseek-v4.1-flash via the registry.
LLM_HARD_PROVIDER=aliyun
LLM_HARD_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_HARD_API_STYLE=openai-compatible
LLM_HARD_API_KEY=
LLM_STANDARD_PROVIDER=aliyun
LLM_STANDARD_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_STANDARD_API_STYLE=openai-compatible
LLM_STANDARD_API_KEY=

# Embedding uses a separate ordinary Bailian key; keep Token Plan keys in LLM_* above.
INVES_COG_EMBEDDING_ENABLED=0
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# The configured embedding is text-embedding-v3, with 1024 dimensions.

# R5: later M8 evidence search; listed here to collect all project prerequisites.
TAVILY_API_KEY=
EXA_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# This project's own database only. Do not point at Muse/stock-pm databases.
INVES_COG_DATABASE_URL=

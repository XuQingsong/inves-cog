# Copy to .env locally. Supply values only in the ignored .env or process environment.
# M1/M2: official Alpaca credentials, with SIP historical market-data permission.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
SEC_USER_AGENT=

# R4: provider, base URL, and protocol must be confirmed for each approved model.
# These variable names are the configuration handoff; adapters are still being built.
# Hard tasks use glm-5.3; standard tasks use deepseek-v4.1-flash via the registry.
LLM_HARD_PROVIDER=
LLM_HARD_BASE_URL=
LLM_HARD_API_STYLE=
LLM_HARD_API_KEY=
LLM_STANDARD_PROVIDER=
LLM_STANDARD_BASE_URL=
LLM_STANDARD_API_STYLE=
LLM_STANDARD_API_KEY=

# DashScope embedding: select the region's endpoint; required model and dimension.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# The configured embedding is text-embedding-v3, with 1024 dimensions.

# R5: later M8 evidence search; listed here to collect all project prerequisites.
TAVILY_API_KEY=
EXA_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# This project's own database only. Do not point at Muse/stock-pm databases.
INVES_COG_DATABASE_URL=
